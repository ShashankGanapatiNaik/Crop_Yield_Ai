# ---- Backend ------------------------------------------------------------
# SQLite for local dev. For PostgreSQL use: postgresql+psycopg2://cropai:cropai@localhost:5432/cropai
DATABASE_URL=sqlite:///./cropai.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# latest = synthetic prototype model_vN | real_latest or real_district_vN = real district-level model (see docs/real-data.md)
MODEL_VERSION=latest
# REPORTS_DIR=ml/reports                 # where /model-plots reads diagnostics from
# CROPAI_CONTACT=you@example.com         # identifies you to Nominatim / NASA POWER in data downloads
# CROPAI_DATA_MODE=synthetic             # default dataset for `python -m ml.src.train` (synthetic | real)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PREDICT=30/minute
RATE_LIMIT_AUTH=10/minute
# Seeded on first start. CHANGE BOTH before any real deployment.
ADMIN_EMAIL=admin@cropai.app
ADMIN_PASSWORD=Admin@12345
LOG_LEVEL=INFO

# ---- docker-compose (PostgreSQL) -----------------------------------------
POSTGRES_USER=cropai
POSTGRES_PASSWORD=cropai
POSTGRES_DB=cropai

# ---- Frontend (build-time, optional) --------------------------------------
# VITE_API_URL=http://localhost:8000     # default is /api (proxied by Vite dev server / nginx)
